// =============================================================================
// OdontoFlow - Schema Prisma Refatorado (Sprint 3 + Exit Inteligente)
// Multi-tenant SaaS de Gerenciamento Clínico Odontológico
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum StockMovementType {
  ENTRY        // Entrada de compra/reposição
  EXIT_MANUAL  // Saída por descarte/perda/ajuste
  EXIT_AUTO    // Baixa Automática por Procedimento Realizado (Exit Inteligente)
}

enum TenantPlan {
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum UserRole {
  ADMIN
  DENTIST
  SECRETARY
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
  FALTOU
  ESPERA
}

enum AppointmentType {
  PARTICULAR
  CONVENIO
}

enum TreatmentStatus {
  ORCAMENTO
  APROVADO
  EM_ANDAMENTO
  CONCLUIDO
  RECUSADO
}

enum Room {
  SALA_1
  SALA_2
  SALA_3
  SALA_4
}

enum PaymentMethod {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
  CONVENIO
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
}

// =============================================================================
// MODELS
// =============================================================================

model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  plan        TenantPlan @default(STANDARD)
  databaseUrl String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clinics           Clinic[]
  users             User[]
  patients          Patient[]
  appointments      Appointment[]
  products          Product[]
  suppliers         Supplier[]
  transactions      Transaction[]
  medicalRecords    MedicalRecord[]
  evolutions        Evolution[]
  toothConditions   ToothCondition[]
  treatmentPlans    TreatmentPlan[]
  procedures        Procedure[]
  planProcedures    PlanProcedure[]
  procedureProducts ProcedureProduct[] // 👈 Adicionado para manter integridade com a pivot
  medicalFiles      MedicalFile[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Clinic {
  id                       String   @id @default(uuid())
  tenantId                 String
  name                     String
  cnpj                     String?  @unique
  phone                    String?
  email                    String?
  address                  String?
  logoUrl                  String?
  paymentIntegrationActive Boolean  @default(false) // 🚩 Feature Flag para Checkout/Gateways
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users          User[]
  patients       Patient[]
  appointments   Appointment[]
  products       Product[]
  transactions   Transaction[]
  suppliers      Supplier[]
  medicalRecords MedicalRecord[]
  treatmentPlans TreatmentPlan[]
  medicalFiles   MedicalFile[]
  auditLogs      AuditLog[]

  @@index([tenantId])
  @@map("clinics")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  clinicId     String
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  phone        String?
  cro          String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]   @relation("DentistAppointments")
  evolutions     Evolution[]
  treatmentPlans TreatmentPlan[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([email])
  @@map("users")
}

model Patient {
  id        String    @id @default(uuid())
  tenantId  String
  clinicId  String
  name      String
  phone     String
  email     String?
  cpf       String?
  birthDate DateTime?
  gender    Gender    @default(NAO_INFORMADO)
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 📍 Endereço detalhado
  zipCode String?
  city    String?
  state   String?

  // 👨‍👩‍👦 Responsável Legal (Pacientes Menores)
  guardianName      String?
  guardianCpf       String?
  guardianBirthDate DateTime?

  // 💳 Dados do Convênio
  insuranceName       String? @default("Particular")
  insuranceCardNumber String?
  insuranceHolderName String?
  insuranceHolderCpf  String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]
  medicalRecord  MedicalRecord?
  treatmentPlans TreatmentPlan[]
  medicalFiles   MedicalFile[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, name])
  @@index([clinicId, deletedAt])
  @@map("patients")
}

model MedicalRecord {
  id               String   @id @default(uuid())
  tenantId         String
  clinicId         String
  patientId        String   @unique
  chiefComplaint   String?  @db.Text
  historyNotes     String?  @db.Text
  allergies        String?  @db.Text
  medications      String?  @db.Text
  bloodType        String?
  habits           String?  @db.Text
  systemicDiseases String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evolutions      Evolution[]
  toothConditions ToothCondition[]

  @@unique([tenantId, patientId])
  @@index([tenantId, clinicId])
  @@map("medical_records")
}

model Evolution {
  id              String   @id @default(uuid())
  tenantId        String
  medicalRecordId String
  dentistId       String
  description     String   @db.Text

  // 📸 Snapshot do odontograma e anexos
  odontogramSnapshot Json?
  attachments        String[] @default([])

  // 🔒 Trava de Imutabilidade (Compliance LGPD/CFO - Trava de 12h)
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  dentist       User          @relation(fields: [dentistId], references: [id])

  @@index([tenantId])
  @@index([medicalRecordId])
  @@index([medicalRecordId, createdAt])
  @@map("evolutions")
}

model ToothCondition {
  id              String   @id @default(uuid())
  tenantId        String
  medicalRecordId String
  toothNumber     Int
  condition       String
  faces           String[]
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@unique([medicalRecordId, toothNumber])
  @@index([tenantId])
  @@map("tooth_conditions")
}

model TreatmentPlan {
  id          String          @id @default(uuid())
  tenantId    String
  clinicId    String
  patientId   String
  dentistId   String
  title       String
  status      TreatmentStatus @default(ORCAMENTO)
  totalAmount Decimal         @db.Decimal(10, 2)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  dentist        User            @relation(fields: [dentistId], references: [id])
  planProcedures PlanProcedure[]
  transactions   Transaction[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, status])
  @@map("treatment_plans")
}

model Procedure {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  basePrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planProcedures    PlanProcedure[]
  procedureProducts ProcedureProduct[] // 🔗 Vínculo com Insumos do Estoque
  appointments      Appointment[]      // 👈 Vínculo com Agendamentos

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("procedures")
}

model PlanProcedure {
  id              String  @id @default(uuid())
  tenantId        String
  treatmentPlanId String
  procedureId     String
  quantity        Int     @default(1)
  actualPrice     Decimal @db.Decimal(10, 2)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  treatmentPlan TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure     Procedure     @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([treatmentPlanId])
  @@map("plan_procedures")
}

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String
  clinicId           String
  patientId          String
  dentistId          String
  procedureId        String?           // 👈 Vínculo opcional para acionar o Exit Inteligente
  dateTime           DateTime
  durationMin        Int               @default(60)
  status             AppointmentStatus @default(AGENDADO)
  type               AppointmentType   @default(PARTICULAR)
  room               Room              @default(SALA_1)
  notes              String?           @db.Text
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  dentist     User         @relation("DentistAppointments", fields: [dentistId], references: [id])
  procedure   Procedure?   @relation(fields: [procedureId], references: [id], onDelete: SetNull) // 👈 Relacionamento adicionado
  transaction Transaction?

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([clinicId, dateTime])
  @@index([clinicId, dentistId, dateTime])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([procedureId])
  @@map("appointments")
}

model Product {
  id                String    @id @default(uuid())
  tenantId          String
  clinicId          String
  supplierId        String?
  name              String
  quantity          Int
  minQuantity       Int
  lotNumber         String?   // 📦 Número do Lote
  manufacturingDate DateTime? 
  expiryDate        DateTime? 
  notes             String?   @db.Text 
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procedureProducts ProcedureProduct[] // 🔗 Relacionamento com procedimentos
  stockMovements    StockMovement[]    // 📊 Histórico de movimentações (Entradas/Saídas)

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, quantity, minQuantity])
  @@index([clinicId, lotNumber])
  @@map("products")
}

// 🧪 Tabela Pivot: Ficha Técnica do Procedimento (Mapeamento de Insumos)
model ProcedureProduct {
  id          String @id @default(uuid())
  tenantId    String
  procedureId String
  productId   String
  quantity    Int    @default(1) // Quantidade gasta deste produto por procedimento

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict) // 👈 Adicionado
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([procedureId, productId])
  @@index([tenantId])
  @@map("procedure_products")
}

// 📦 Histórico de Movimentação de Estoque
model StockMovement {
  id        String            @id @default(uuid())
  tenantId  String
  clinicId  String
  productId String
  userId    String?
  type      StockMovementType
  quantity  Int               // Quantidade movimentada (positiva para entradas, negativa para saídas)
  reason    String?           // Ex: "Baixa Automática: Restauração Resina (Agendamento #XYZ)"
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, clinicId])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  clinicId  String
  name      String
  cnpj      String?
  phone     String?
  email     String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  products Product[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@map("suppliers")
}

model Transaction {
  id              String          @id @default(uuid())
  tenantId        String
  clinicId        String
  appointmentId   String?         @unique
  treatmentPlanId String?         // 🔗 Vínculo opcional com orçamento
  amount          Decimal         @db.Decimal(10, 2)
  type            TransactionType @default(RECEITA)
  paymentMethod   PaymentMethod
  description     String?
  category        String?
  paidAt          DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, clinicId])
  @@index([clinicId, type, paidAt])
  @@index([clinicId, paymentMethod])
  @@map("transactions")
}

model MedicalFile {
  id        String    @id @default(uuid())
  tenantId  String
  clinicId  String
  patientId String
  url       String
  name      String
  size      Int
  deletedAt DateTime? // 🖼️ Soft Delete (>24h retenção CFO/LGPD)
  createdAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([tenantId, clinicId])
  @@index([clinicId, deletedAt])
  @@map("medical_files")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  clinicId  String
  userId    String?
  userName  String?
  userRole  UserRole?
  action    AuditAction
  entity    String      // Ex: "APPOINTMENT", "TRANSACTION", "EVOLUTION", "PRODUCT", "MEDICAL_FILE"
  entityId  String?
  details   String?     @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}