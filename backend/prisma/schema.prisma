// =============================================================================
// OdontoFlow - Schema Prisma Consolidado & Enterprise Compliance
// Multi-tenant SaaS de Gerenciamento Clínico Odontológico (Next.js + Node/Express)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// =============================================================================
// ENUMS
// =============================================================================

enum StockMovementType {
  ENTRY        // Entrada de compra/reposição
  EXIT_MANUAL  // Saída por descarte/perda/ajuste
  EXIT_AUTO    // Baixa Automática por Procedimento Realizado (Exit Inteligente)
}

enum TenantPlan {
  BASIC
  PREMIUM
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL        // Período de 7 dias grátis
  ACTIVE       // Em dia / Ativo
  PAST_DUE     // Inadimplente / Em tolerância
  PAUSED       // Suspenso
  CANCELED     // Cancelado
}

enum UnitType {
  UN // Unidade / Tubete / Seringa
  ML // Mililitros
  MG // Miligramas
  G  // Gramas
  L  // Litros
  CX // Caixa / Embalagem
}

enum UserRole {
  ADMIN
  DENTIST
  SECRETARY
}

enum SystemModule {
  DASHBOARD
  AGENDA
  PATIENTS
  RECORDS
  STOCK
  FINANCIAL
  PROCEDURES
  SUPPLIERS
  SETTINGS
  REPORTS
  AI_TRANSCRIPTION
  COMMISSIONS
  TASKS
  MY_OFFICE // Módulo "Meu Consultório"
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
  FALTOU
  ESPERA
}

enum AppointmentType {
  PARTICULAR
  CONVENIO
}

enum TreatmentStatus {
  ORCAMENTO
  APROVADO
  EM_ANDAMENTO
  CONCLUIDO
  RECUSADO
}

enum Room {
  SALA_1
  SALA_2
  SALA_3
  SALA_4
}

enum PaymentMethod {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
  CONVENIO
  BOLETO
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  REJECTED
}

enum PreRegStatus {
  PENDING
  COMPLETED
  EXPIRED
}

// =============================================================================
// MODELS: CORE & MULTI-TENANCY
// =============================================================================

model Tenant {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  plan          TenantPlan         @default(PREMIUM)
  billingCycle  BillingCycle       @default(ANNUAL)
  status        SubscriptionStatus @default(TRIAL)
  trialEndsAt   DateTime?
  isBetaPartner Boolean            @default(false) // Trava especial para parceiros de teste
  databaseUrl   String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  clinics                Clinic[]
  users                  User[]
  patients               Patient[]
  appointments           Appointment[]
  products               Product[]
  suppliers              Supplier[]
  transactions           Transaction[]
  medicalRecords         MedicalRecord[]
  evolutions             Evolution[]
  toothConditions        ToothCondition[]
  treatmentPlans         TreatmentPlan[]
  procedures             Procedure[]
  planProcedures         PlanProcedure[]
  procedureProducts      ProcedureProduct[]
  medicalFiles           MedicalFile[]
  auditLogs              AuditLog[]
  subscription           Subscription?
  rolePermissions        RolePermission[]
  clinicalTasks          ClinicTask[]
  commissions            DentistCommission[]
  contracts              ClinicalContract[]
  publicPreRegistrations PublicPreRegistration[]
  aiTranscriptions       ClinicalAiTranscription[]
  dentistProfiles        DentistProfile[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  plan               TenantPlan         @default(PREMIUM)
  status             SubscriptionStatus @default(TRIAL)
  billingCycle       BillingCycle       @default(ANNUAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  gracePeriodEndsAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model Clinic {
  id                       String   @id @default(uuid())
  tenantId                 String
  name                     String
  cnpj                     String?  @unique
  phone                    String?
  email                    String?
  address                  String?
  logoUrl                  String?
  paymentIntegrationActive Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customization          ClinicCustomization?
  users                  User[]
  patients               Patient[]
  appointments           Appointment[]
  products               Product[]
  transactions           Transaction[]
  suppliers              Supplier[]
  medicalRecords         MedicalRecord[]
  treatmentPlans         TreatmentPlan[]
  medicalFiles           MedicalFile[]
  auditLogs              AuditLog[]
  rolePermissions        RolePermission[]
  clinicalTasks          ClinicTask[]
  commissions            DentistCommission[]
  contracts              ClinicalContract[]
  publicPreRegistrations PublicPreRegistration[]
  dentistProfiles        DentistProfile[]

  @@index([tenantId])
  @@map("clinics")
}

model ClinicCustomization {
  id                   String   @id @default(uuid())
  clinicId             String   @unique
  clinicName           String?
  primaryColor         String   @default("#06b6d4")
  accentColor          String   @default("#0891b2")
  secondaryColor       String?  @default("#0f172a")
  fontFamily           String   @default("Inter")
  darkModeDefault      Boolean  @default(false)
  
  // Customização de Marca e Impressos (White-Label)
  customLogoUrl        String?
  customFavicon        String?
  customDocumentHeader String?  @db.Text
  customReceiptFooter  String?  @db.Text

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_customizations")
}

model RolePermission {
  id        String       @id @default(uuid())
  tenantId  String
  clinicId  String?
  role      UserRole
  module    SystemModule
  canRead   Boolean      @default(true)
  canCreate Boolean      @default(false)
  canUpdate Boolean      @default(false)
  canDelete Boolean      @default(false)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clinicId, role, module])
  @@index([tenantId, role])
  @@index([clinicId, role])
  @@map("role_permissions")
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  clinicId            String
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole
  phone               String?
  cro                 String?
  avatarUrl           String?
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  
  // Proteção contra ataques de força bruta
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Configuração padrão de repasse do profissional
  defaultCommissionPercentage Decimal? @db.Decimal(5, 2)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic           Clinic                    @relation(fields: [clinicId], references: [id])
  appointments     Appointment[]             @relation("DentistAppointments")
  evolutions       Evolution[]
  treatmentPlans   TreatmentPlan[]
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  assignedTasks    ClinicTask[]              @relation("AssignedTasks")
  createdTasks     ClinicTask[]              @relation("CreatedTasks")
  commissions      DentistCommission[]       @relation("DentistCommissions")
  aiTranscriptions ClinicalAiTranscription[]
  dentistProfile   DentistProfile?

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([email])
  @@map("users")
}

// =============================================================================
// NOVO MODEL: MEU CONSULTÓRIO (PERFIL E PREFERÊNCIAS DO CIRURGIÃO-DENTISTA)
// =============================================================================

model DentistProfile {
  id                String   @id @default(uuid())
  tenantId          String
  clinicId          String
  userId            String   @unique
  
  // Identificação e Atuação
  specialties       String[] @default([]) // Ex: ["Ortodontia", "Implantodontia", "Harmonização"]
  bio               String?  @db.Text
  defaultRoom       Room     @default(SALA_1) // Consultório/Cadeira preferencial
  
  // Regulação e Validação em Documentos/Receituários
  signatureImageUrl String?  // Assinatura digitalizada para carimbo automático
  croState          String?  // Ex: "CE", "SP"
  rqe               String?  // Registro de Qualificação de Especialista (se houver)

  // Configurações da Agenda Individual
  slotDurationMin   Int      @default(30) // Duração média da consulta na cadeira
  workSchedule      Json?    // Ex: { "seg": { "start": "08:00", "end": "18:00", "lunch": "12:00-13:00" } }
  
  // Produtividade & IA
  aiVoiceShortcut   Boolean  @default(true) // Habilita gravação direta no mocho
  quickNotes        Json?    // Textos rápidos / templates de conduta favoritos

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, clinicId])
  @@map("dentist_profiles")
}

// =============================================================================
// MODELS: PACIENTES, PRONTUÁRIOS & COMPLIANCE CFO/LGPD
// =============================================================================

model Patient {
  id        String    @id @default(uuid())
  tenantId  String
  clinicId  String
  name      String
  phone     String
  email     String?
  cpf       String?
  birthDate DateTime?
  gender    Gender    @default(NAO_INFORMADO)
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  zipCode String?
  city    String?
  state   String?

  guardianName      String?
  guardianCpf       String?
  guardianBirthDate DateTime?

  insuranceName       String? @default("Particular")
  insuranceCardNumber String?
  insuranceHolderName String?
  insuranceHolderCpf  String?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic                 Clinic                  @relation(fields: [clinicId], references: [id])
  appointments           Appointment[]
  medicalRecord          MedicalRecord?
  treatmentPlans         TreatmentPlan[]
  medicalFiles           MedicalFile[]
  clinicalTasks          ClinicTask[]
  contracts              ClinicalContract[]
  publicPreRegistrations PublicPreRegistration[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, name])
  @@index([clinicId, deletedAt])
  @@map("patients")
}

model MedicalRecord {
  id               String   @id @default(uuid())
  tenantId         String
  clinicId         String
  patientId        String   @unique
  chiefComplaint   String?  @db.Text
  historyNotes     String?  @db.Text
  allergies        String?  @db.Text
  medications      String?  @db.Text
  bloodType        String?
  habits           String?  @db.Text
  systemicDiseases String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evolutions      Evolution[]
  toothConditions ToothCondition[]

  @@unique([tenantId, patientId])
  @@index([tenantId, clinicId])
  @@map("medical_records")
}

model Evolution {
  id              String   @id @default(uuid())
  tenantId        String
  medicalRecordId String
  dentistId       String
  procedureId     String?
  description     String   @db.Text

  odontogramSnapshot Json?
  attachments        String[] @default([])

  // Trava Temporal CFO / LGPD (24 Horas)
  isLocked            Boolean   @default(false)
  lockedAt            DateTime?
  rectificationReason String?   @db.Text

  // Rastreabilidade de Transcrição por Inteligência Artificial
  isAiGenerated       Boolean   @default(false)
  aiTranscriptionId   String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicalRecord   MedicalRecord            @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  dentist         User                     @relation(fields: [dentistId], references: [id])
  procedure       Procedure?               @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  aiTranscription ClinicalAiTranscription? @relation(fields: [aiTranscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([medicalRecordId])
  @@index([medicalRecordId, createdAt])
  @@map("evolutions")
}

model ToothCondition {
  id              String   @id @default(uuid())
  tenantId        String
  medicalRecordId String
  toothNumber     Int
  condition       String
  faces           String[]
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@unique([medicalRecordId, toothNumber])
  @@index([tenantId])
  @@map("tooth_conditions")
}

// =============================================================================
// MODEL: TRANSCRIÇÃO & ESTRUTURAÇÃO DE CONSULTA COM IA
// =============================================================================

model ClinicalAiTranscription {
  id               String   @id @default(uuid())
  tenantId         String
  dentistId        String
  audioUrl         String?
  durationSeconds  Int?
  rawTranscription String   @db.Text
  structuredData   Json?
  tokensUsed       Int?
  modelName        String   @default("whisper-1 / gpt-4o-mini")
  createdAt        DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dentist   User       @relation(fields: [dentistId], references: [id])
  evolution Evolution?

  @@index([tenantId])
  @@index([dentistId])
  @@map("clinical_ai_transcriptions")
}

// =============================================================================
// MODELS: TRATAMENTOS, PROCEDIMENTOS & COMISSÕES
// =============================================================================

model TreatmentPlan {
  id          String          @id @default(uuid())
  tenantId    String
  clinicId    String
  patientId   String
  dentistId   String
  title       String
  status      TreatmentStatus @default(ORCAMENTO)
  totalAmount Decimal         @db.Decimal(10, 2)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id])
  dentist        User                @relation(fields: [dentistId], references: [id])
  planProcedures PlanProcedure[]
  transactions   Transaction[]
  commissions    DentistCommission[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, status])
  @@map("treatment_plans")
}

model Procedure {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  basePrice   Decimal  @db.Decimal(10, 2)
  durationMin Int      @default(30)
  category    String?  @default("Dentística / Estética")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planProcedures    PlanProcedure[]
  procedureProducts ProcedureProduct[]
  appointments      Appointment[]
  evolutions        Evolution[]
  commissions       DentistCommission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("procedures")
}

model PlanProcedure {
  id              String  @id @default(uuid())
  tenantId        String
  treatmentPlanId String
  procedureId     String
  quantity        Int     @default(1)
  actualPrice     Decimal @db.Decimal(10, 2)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  treatmentPlan TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure     Procedure     @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([treatmentPlanId])
  @@map("plan_procedures")
}

model DentistCommission {
  id               String           @id @default(uuid())
  tenantId         String
  clinicId         String
  dentistId        String
  treatmentPlanId  String?
  procedureId      String?
  grossAmount      Decimal          @db.Decimal(10, 2)
  materialsCost    Decimal          @default(0) @db.Decimal(10, 2)
  netBaseAmount    Decimal          @db.Decimal(10, 2)
  percentage       Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(10, 2)
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  dentist       User           @relation("DentistCommissions", fields: [dentistId], references: [id])
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  procedure     Procedure?     @relation(fields: [procedureId], references: [id])

  @@index([tenantId, clinicId])
  @@index([dentistId, status])
  @@map("dentist_commissions")
}

// =============================================================================
// MODELS: AGENDAMENTOS & TRAVA DE IDEMPOTÊNCIA
// =============================================================================

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String
  clinicId           String
  patientId          String
  dentistId          String
  procedureId        String?
  dateTime           DateTime
  durationMin        Int               @default(60)
  status             AppointmentStatus @default(AGENDADO)
  type               AppointmentType   @default(PARTICULAR)
  room               Room              @default(SALA_1)
  notes              String?           @db.Text
  cancellationReason String?
  cancelledAt        DateTime?

  // Trava de Idempotência: sinaliza se o Exit Inteligente já foi disparado
  autoStockDeducted  Boolean           @default(false)

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  dentist     User          @relation("DentistAppointments", fields: [dentistId], references: [id])
  procedure   Procedure?    @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([clinicId, dateTime])
  @@index([clinicId, dentistId, dateTime])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([procedureId])
  @@map("appointments")
}

// =============================================================================
// MODELS: ESTOQUE, FRACIONAMENTO UNIVERSAL & EXIT INTELIGENTE
// =============================================================================

model Product {
  id                String    @id @default(uuid())
  tenantId          String
  clinicId          String
  supplierId        String?
  name              String
  quantity          Float     @default(0)
  minQuantity       Float     @default(1)
  unit              UnitType  @default(UN)
  costPrice         Decimal?  @db.Decimal(10, 2)
  itemsPerPackage   Int?      @default(1)
  lotNumber         String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procedureProducts ProcedureProduct[]
  stockMovements    StockMovement[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([clinicId, quantity, minQuantity])
  @@index([clinicId, lotNumber])
  @@map("products")
}

model ProcedureProduct {
  id          String   @id @default(uuid())
  tenantId    String
  procedureId String
  productId   String
  quantity    Float    @default(1.0)
  unit        UnitType @default(UN)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([procedureId, productId])
  @@index([tenantId])
  @@map("procedure_products")
}

model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String
  clinicId      String
  productId     String
  userId        String?
  type          StockMovementType
  quantity      Float
  reason        String?

  // Chaves de concorrência e idempotência
  appointmentId String?
  procedureId   String?

  createdAt     DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, clinicId])
  @@index([productId, createdAt])
  @@index([tenantId, appointmentId, type])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  clinicId  String
  name      String
  cnpj      String?
  phone     String?
  email     String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  products     Product[]
  transactions Transaction[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@map("suppliers")
}

// =============================================================================
// MODELS: FINANCEIRO & DRE ANALÍTICO
// =============================================================================

model Transaction {
  id              String          @id @default(uuid())
  tenantId        String
  clinicId        String
  appointmentId   String?         @unique
  treatmentPlanId String?
  supplierId      String?
  amount          Decimal         @db.Decimal(10, 2)
  type            TransactionType @default(RECEITA)
  paymentMethod   PaymentMethod
  description     String?
  category        String?
  costCenter      String?
  isReconciled    Boolean         @default(true)
  paidAt          DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, clinicId])
  @@index([clinicId, type, paidAt])
  @@index([clinicId, paymentMethod])
  @@index([supplierId])
  @@map("transactions")
}

// =============================================================================
// MODELS: TAREFAS, CONTRATOS & PRÉ-CADASTRO DIGITAL
// =============================================================================

model ClinicTask {
  id           String       @id @default(uuid())
  tenantId     String
  clinicId     String
  creatorId    String
  assignedToId String?
  patientId    String?
  title        String
  description  String?      @db.Text
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  creator    User     @relation("CreatedTasks", fields: [creatorId], references: [id])
  assignedTo User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, clinicId])
  @@index([assignedToId, status])
  @@map("clinic_tasks")
}

model ClinicalContract {
  id           String         @id @default(uuid())
  tenantId     String
  clinicId     String
  patientId    String
  title        String
  contentHtml  String         @db.Text
  status       ContractStatus @default(DRAFT)
  signatureUrl String?
  signedAt     DateTime?
  signerIp     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clinicId])
  @@index([patientId, status])
  @@map("clinical_contracts")
}

model PublicPreRegistration {
  id          String       @id @default(uuid())
  tenantId    String
  clinicId    String
  patientId   String?
  token       String       @unique
  patientName String
  phone       String
  formData    Json?
  status      PreRegStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, clinicId])
  @@index([token])
  @@map("public_pre_registrations")
}

// =============================================================================
// MODELS: ARQUIVOS & AUDITORIA LGPD
// =============================================================================

model MedicalFile {
  id        String    @id @default(uuid())
  tenantId  String
  clinicId  String
  patientId String
  url       String
  name      String
  size      Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([tenantId, clinicId])
  @@index([clinicId, deletedAt])
  @@map("medical_files")
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  clinicId  String
  userId    String?
  userName  String?
  userRole  UserRole?
  action    AuditAction
  entity    String
  entityId  String?
  details   String?     @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, clinicId])
  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}